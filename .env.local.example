# Copy to .env.local (gitignored) and pass it to compose:
#   docker compose --env-file .env.local up --build
# These values are for a container that listens on localhost only.
POSTGRES_USER=bakehouse
POSTGRES_PASSWORD=local-only-password
POSTGRES_DB=bakehouse
# Host port for Postgres. Not 5432, so it does not clash with a Postgres already running.
POSTGRES_HOST_PORT=5433
# Host port for the app, and the name recorded when a change is saved.
APP_HOST_PORT=8050
APP_USER=local-user
